{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-skill/artifact",
  "title": "artifacts/*.meta.json (Phase 3)",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "provider",
    "artifact_type",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "extracted_text_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    }
  }
}
