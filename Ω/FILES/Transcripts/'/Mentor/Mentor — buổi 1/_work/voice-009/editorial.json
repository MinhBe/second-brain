  "corrections": {
    "S00004": "Để sinh dữ liệu tấn công SQL injection.",
    "S00005": "Nhằm nâng cao phát hiện dựa trên học máy.",
    "S00009": "Dữ liệu SQL injection có kiểm soát.",
    "S00024": "Tên đề tài của em là nghiên cứu mô hình GAN cho sinh dữ liệu tấn công SQL.",
    "S00025": "Nhằm nâng cao mô hình phát hiện dựa trên học máy.",
    "S00028": "Cho nên mục tiêu tổng quát phải gắn với GAN.",
    "S00060": "Theo thầy nói em là SMOTE là baseline của các phương pháp cân bằng.",
    "S00064": "Nhóm GAN đấy là nhóm trọng tâm của đồ án.",
    "S00085": "Cái đấy phải nhớ về chỉnh sửa cho đúng theo đề cương nhé.",
    "S00115": "Thì đây là quy trình tiền xử lý dữ liệu của em ạ.",
    "S00118": "Một cột payload và một cột được đánh nhãn.",
    "S00222": "Tiếp theo là trong bài toán mà tác giả Yu đưa ra.",
    "S00240": "Thế nên là nó sẽ lặp đi lặp lại một cấu trúc chung ạ."
  },
